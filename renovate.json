{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":pinVersions",
    "docker:pinDigests"
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates once checks pass",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Auto-merge pin and digest updates once checks pass",
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true
    },
    {
      "description": "Require manual review for major updates",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}
